rules_version = '2';

// Regole per il progetto Firebase DEDICATO a questa chat: si incollano così come sono
// (Firebase Console → Firestore Database → Regole → Pubblica).
// Admin = utente con un documento in admins/{uid}: crealo a mano dalla console con l'UID
// preso da Authentication → Users (come per la dashboard del sito).

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function shortStr(v, n) { return v is string && v.size() <= n; }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Chat degli agenti: la leggono solo gli admin. Il titolare (admin) può solo AGGIUNGERE
    // propri messaggi (testo o vocale); i messaggi degli agenti li scrive /api/agent-chat.
    match /agent_messages/{id} {
      allow read, delete: if isAdmin();
      allow update: if false;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['from', 'to', 'conv', 'text', 'audio', 'createdAt'])
        && request.resource.data.from == 'owner'
        && request.resource.data.to in ['group', 'sito', 'direttore', 'seo', 'blog', 'performance', 'competitor', 'sicurezza']
        && request.resource.data.conv == (request.resource.data.to == 'group' ? 'group' : 'dm_' + request.resource.data.to)
        && shortStr(request.resource.data.createdAt, 40)
        && (('text' in request.resource.data) != ('audio' in request.resource.data))
        && (!('text' in request.resource.data) || shortStr(request.resource.data.text, 4000))
        && (!('audio' in request.resource.data) || (
             request.resource.data.audio.keys().hasOnly(['b64', 'mime', 'sec'])
             && shortStr(request.resource.data.audio.b64, 700000)
             && shortStr(request.resource.data.audio.mime, 40)
             && request.resource.data.audio.sec is number));
    }

    match /{document=**} { allow read, write: if false; }
  }
}
