# Firebase (browser): valori del progetto Firebase DEDICATO alla chat (Project Settings → Your apps → Config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Solo server (mai nel browser)
FIREBASE_SERVICE_ACCOUNT_KEY=   # JSON dell'account di servizio, su una riga
AGENT_CHAT_TOKEN=               # stringa casuale, almeno 24 caratteri

# Sveglia degli agenti (facoltativa): per ogni agente, indirizzo e token dell'API trigger della sua routine su claude.ai
AGENT_WAKE_SEO_URL=
AGENT_WAKE_SEO_TOKEN=
# ...stesso schema per gli altri agenti (SITO, DIRETTORE, SEO, BLOG, PERFORMANCE, COMPETITOR, SICUREZZA)
AGENT_GROUP_WAKE=direttore      # agenti svegliati dai messaggi al gruppo (separati da virgola)
