# Firebase (browser): valori del progetto Firebase DEDICATO alla chat (Project Settings → Your apps → Config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Solo server (mai nel browser)
FIREBASE_SERVICE_ACCOUNT_KEY=   # JSON dell'account di servizio, su una riga
AGENT_CHAT_TOKEN=               # stringa casuale, almeno 24 caratteri

# Sveglia degli agenti (facoltativa): indirizzo e token dell'API trigger della routine su claude.ai.
# Una routine per tutti gli agenti:
AGENT_WAKE_URL=
AGENT_WAKE_TOKEN=
# (facoltativo, una routine per agente: AGENT_WAKE_SEO_URL / AGENT_WAKE_SEO_TOKEN, ecc.)
AGENT_GROUP_WAKE=direttore      # agenti svegliati dai messaggi al gruppo (separati da virgola)

# Regolazioni della sveglia (facoltative; tra parentesi il valore predefinito)
AGENT_WAKE_LIMIT_PER_HOUR=      # (30) sveglie l'ora per agente; 0 = nessun limite nostro
AGENT_WAKE_BURST_SECONDS=       # (15) un agente appena svegliato non viene risvegliato; 0 = disattivato
AGENT_WAKE_DUPLICATE_SECONDS=   # (60) stesso testo ripetuto non risveglia; 0 = disattivato
AGENT_CHAIN_MAX=                # (8) messaggi di agenti di fila senza il titolare che possono ancora svegliare
