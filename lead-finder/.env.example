# Facoltativa: protegge le API (header Authorization: Bearer ...). Se vuota, le API sono aperte.
LEAD_FINDER_TOKEN=
# Facoltativa: chiave gratuita Google PageSpeed Insights (senza chiave funziona con quota bassa)
PAGESPEED_API_KEY=
# Facoltativa: token Meta Ad Library (gratuito, account sviluppatore verificato). Senza, l'app offre il link diretto alla Ads Library.
META_AD_LIBRARY_TOKEN=
# Per Stratega e Operativo (chat strategia, messaggi AI, report post-call). Costo a consumo: pochi centesimi per richiesta.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# NB: per l'AI LEAD_FINDER_TOKEN è obbligatorio (altrimenti l'endpoint rifiuta).

# Sincronizzazione tra dispositivi (facoltativa): progetto Firebase con Authentication (email/password) e Firestore
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
