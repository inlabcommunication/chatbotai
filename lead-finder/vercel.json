{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "functions": { "api/search.ts": { "maxDuration": 30 }, "api/audit.ts": { "maxDuration": 30 }, "api/landing.ts": { "maxDuration": 30 }, "api/ads.ts": { "maxDuration": 25 }, "api/social.ts": { "maxDuration": 20 }, "api/ai.ts": { "maxDuration": 60 }, "api/status.ts": { "maxDuration": 5 } },
  "headers": [
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }, { "key": "X-Content-Type-Options", "value": "nosniff" }] }
  ]
}
