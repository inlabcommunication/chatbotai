rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo gli utenti il cui UID è un documento in /admins possono leggere e scrivere i lead.
    function isAdmin() { return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    match /leads/{id} { allow read, write: if isAdmin(); }
    match /{document=**} { allow read, write: if false; }
  }
}
